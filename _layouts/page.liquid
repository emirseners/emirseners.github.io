---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/pages.css' | relative_url | bust_file_cache }}">
{% if page.stylesheet %}
  <link rel="stylesheet" href="{{ page.stylesheet | relative_url | bust_file_cache }}">
{% endif %}
<div class="post{% if page.page_class %} {{ page.page_class | escape }}{% endif %}">
  <header class="post-header">
    <h1 class="post-title">
      {% if page.permalink == '/' %}
        {{ site.title | escape }}
      {% else %}
        {{ page.title | escape }}
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>
  <article>{{ content }}</article>
</div>
